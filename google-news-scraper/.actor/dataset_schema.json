{
    "actorSpecification": 1,
    "fields": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
            "query": {
                "type": [
                    "string",
                    "null"
                ],
                "description": "Search query this article was found for"
            },
            "topic": {
                "type": [
                    "string",
                    "null"
                ],
                "description": "Topic, for topic headlines"
            },
            "edition": {
                "type": [
                    "string",
                    "null"
                ],
                "description": "Google News edition, COUNTRY:language"
            },
            "position": {
                "type": [
                    "integer",
                    "null"
                ],
                "description": "Rank within the query, newest first"
            },
            "title": {
                "type": [
                    "string",
                    "null"
                ],
                "description": "Headline"
            },
            "source": {
                "type": [
                    "string",
                    "null"
                ],
                "description": "Publisher name"
            },
            "sourceUrl": {
                "type": [
                    "string",
                    "null"
                ],
                "description": "Publisher site"
            },
            "sourceDomain": {
                "type": [
                    "string",
                    "null"
                ],
                "description": "Publisher domain"
            },
            "publishedAt": {
                "type": [
                    "string",
                    "null"
                ],
                "description": "Publication time, ISO 8601 UTC"
            },
            "googleNewsUrl": {
                "type": [
                    "string",
                    "null"
                ],
                "description": "Article link (opens the article through Google News)"
            },
            "url": {
                "type": [
                    "string",
                    "null"
                ],
                "description": "Direct URL of the article on the publisher's site"
            },
            "ampUrl": {
                "type": [
                    "string",
                    "null"
                ],
                "description": "AMP version of the article, when there is one"
            },
            "urlError": {
                "type": [
                    "string",
                    "null"
                ],
                "description": "Why the publisher URL could not be resolved"
            },
            "imageUrl": {
                "type": [
                    "string",
                    "null"
                ],
                "description": "Main image of the article (with article details)"
            },
            "description": {
                "type": [
                    "string",
                    "null"
                ],
                "description": "Article summary from the publisher page"
            },
            "author": {
                "type": [
                    "string",
                    "null"
                ],
                "description": "Author(s)"
            },
            "pageDate": {
                "type": [
                    "string",
                    "null"
                ],
                "description": "Date on the publisher page"
            },
            "siteName": {
                "type": [
                    "string",
                    "null"
                ],
                "description": "Site name"
            },
            "wordCount": {
                "type": [
                    "integer",
                    "null"
                ],
                "description": "Words in the article text"
            },
            "text": {
                "type": [
                    "string",
                    "null"
                ],
                "description": "Clean article text (with full text)"
            },
            "detailsError": {
                "type": [
                    "string",
                    "null"
                ],
                "description": "Why the publisher page could not be read"
            },
            "articleId": {
                "type": [
                    "string",
                    "null"
                ],
                "description": "Google News article id"
            },
            "relatedCoverage": {
                "type": "array",
                "description": "Other outlets on the same story: title, source, googleNewsUrl"
            }
        }
    },
    "views": {
        "overview": {
            "title": "Articles",
            "transformation": {
                "fields": [
                    "publishedAt",
                    "title",
                    "source",
                    "query",
                    "topic",
                    "edition",
                    "url",
                    "imageUrl"
                ]
            },
            "display": {
                "component": "table",
                "properties": {
                    "url": {
                        "label": "Article",
                        "format": "link"
                    },
                    "publishedAt": {
                        "label": "Published",
                        "format": "date"
                    },
                    "imageUrl": {
                        "label": "Image",
                        "format": "image"
                    }
                }
            }
        }
    }
}