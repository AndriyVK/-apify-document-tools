{
    "actorSpecification": 1,
    "fields": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
            "url": { "type": ["string", "null"], "description": "Input file URL (null for merged.pdf and all-files.zip)" },
            "fileName": { "type": ["string", "null"], "description": "File name from the server or URL" },
            "kind": { "type": "string", "description": "pdf or image" },
            "outputFormat": { "type": "string", "description": "png, jpeg, webp, tiff or pdf" },
            "sourcePages": { "type": "integer", "description": "Pages in the input PDF" },
            "count": { "type": "integer", "description": "Produced files (pages or frames)" },
            "files": { "type": "array", "description": "Produced files: key, url (download link), bytes" },
            "merged": { "type": "boolean", "description": "This item is merged.pdf" },
            "zip": { "type": "boolean", "description": "This item is all-files.zip" },
            "warnings": { "type": "array", "items": { "type": "string" } },
            "error": { "type": "string", "description": "Why the file could not be converted (not charged)" }
        }
    },
    "views": {
        "overview": {
            "title": "Overview",
            "transformation": { "fields": ["url", "kind", "outputFormat", "count", "files", "error"] },
            "display": {
                "component": "table",
                "properties": {
                    "url": { "label": "File", "format": "link" },
                    "kind": { "label": "Input" },
                    "outputFormat": { "label": "Output" },
                    "count": { "label": "Files", "format": "number" },
                    "files": { "label": "Download", "format": "array" },
                    "error": { "label": "Error" }
                }
            }
        }
    }
}
