{
    "title": "Text to Speech",
    "type": "object",
    "schemaVersion": 1,
    "properties": {
        "text": {
            "title": "Text",
            "type": "string",
            "editor": "textarea",
            "description": "Text to read aloud. Blank lines separate paragraphs (a longer pause).",
            "prefill": "Hello! This is a natural-sounding neural voice. It can read articles, documents and books aloud, and it creates subtitles too.",
            "default": "Hello! This is a natural-sounding neural voice. It can read articles, documents and books aloud, and it creates subtitles too."
        },
        "sources": {
            "title": "Document URLs (optional)",
            "type": "array",
            "editor": "requestListSources",
            "description": "Links to TXT, Markdown, HTML, PDF (with a text layer) or DOCX files; each becomes one audio file. Files in your own Apify key-value store work too: set the store's access to \"Anyone with ID can read\" and use https://api.apify.com/v2/key-value-stores/<store ID>/records/<key>.",
            "default": []
        },
        "voice": {
            "title": "Voice",
            "type": "string",
            "editor": "select",
            "description": "Pick a voice in the language of your text. \"high\" voices sound most natural and cost more per minute (see Pricing); \"medium\"/\"low\" voices are fast and cheap.",
            "enum": [
                "uk_UA-mykyta-high",
                "uk_UA-tetiana-high",
                "uk_UA-oleksa-high",
                "en_US-ljspeech-high",
                "en_US-john-medium",
                "en_US-kristin-medium",
                "en_US-bryce-medium",
                "en_US-norman-medium",
                "en_US-joe-medium",
                "en_GB-cori-high",
                "en_GB-alba-medium",
                "de_DE-thorsten-high",
                "de_DE-kerstin-low",
                "fr_FR-siwis-medium",
                "fr_FR-gilles-low",
                "es_ES-davefx-medium",
                "es_MX-claude-high",
                "it_IT-serena-high",
                "pl_PL-gosia-medium",
                "pl_PL-darkman-medium",
                "pt_BR-faber-medium",
                "nl_NL-pim-medium",
                "cs_CZ-jirka-medium",
                "ru_RU-denis-medium",
                "ru_RU-dmitri-medium",
                "ro_RO-mihai-medium",
                "fi_FI-harri-medium",
                "hu_HU-anna-medium",
                "sk_SK-lili-medium",
                "sv_SE-nst-medium",
                "da_DK-talesyntese-medium",
                "el_GR-rapunzelina-medium",
                "lv_LV-aivars-medium",
                "sl_SI-artur-medium",
                "zh_CN-chaowen-medium",
                "fa_IR-amir-medium",
                "vi_VN-vais1000-medium"
            ],
            "enumTitles": [
                "Ukrainian — Mykyta (high quality, recommended)",
                "Ukrainian — Tetiana (high quality)",
                "Ukrainian — Oleksa (high quality)",
                "English (US) — Ljspeech (high quality)",
                "English (US) — John (medium quality)",
                "English (US) — Kristin (medium quality)",
                "English (US) — Bryce (medium quality)",
                "English (US) — Norman (medium quality)",
                "English (US) — Joe (medium quality)",
                "English (UK) — Cori (high quality)",
                "English (UK) — Alba (medium quality)",
                "German — Thorsten (high quality)",
                "German — Kerstin (low quality)",
                "French — Siwis (medium quality)",
                "French — Gilles (low quality)",
                "Spanish (Spain) — Davefx (medium quality)",
                "Spanish (Mexico) — Claude (high quality)",
                "Italian — Serena (high quality)",
                "Polish — Gosia (medium quality)",
                "Polish — Darkman (medium quality)",
                "Portuguese (Brazil) — Faber (medium quality)",
                "Dutch — Pim (medium quality)",
                "Czech — Jirka (medium quality)",
                "Russian — Denis (medium quality)",
                "Russian — Dmitri (medium quality)",
                "Romanian — Mihai (medium quality)",
                "Finnish — Harri (medium quality)",
                "Hungarian — Anna (medium quality)",
                "Slovak — Lili (medium quality)",
                "Swedish — Nst (medium quality)",
                "Danish — Talesyntese (medium quality)",
                "Greek — Rapunzelina (medium quality)",
                "Latvian — Aivars (medium quality)",
                "Slovenian — Artur (medium quality)",
                "Chinese — Chaowen (medium quality)",
                "Persian — Amir (medium quality)",
                "Vietnamese — Vais1000 (medium quality)"
            ],
            "default": "en_US-john-medium"
        },
        "speed": {
            "title": "Speed",
            "type": "number",
            "description": "0.5 = slow, 1 = the voice's own pace, 1.12 = default (smoother, fewer hesitations), 1.5 = fast.",
            "minimum": 0.5,
            "maximum": 2,
            "default": 1.12
        },
        "style": {
            "title": "Delivery",
            "type": "string",
            "editor": "select",
            "description": "\"Lively\" varies intonation and rhythm more, \"Standard\" is even and calm. \"Auto\" picks Lively for Ukrainian voices (rated best by ear) and Standard for other languages.",
            "enum": [
                "auto",
                "lively",
                "standard"
            ],
            "enumTitles": [
                "Auto",
                "Lively",
                "Standard"
            ],
            "default": "auto"
        },
        "format": {
            "title": "Audio format",
            "type": "string",
            "editor": "select",
            "enum": [
                "mp3",
                "wav",
                "ogg"
            ],
            "enumTitles": [
                "MP3 (64 kbit/s)",
                "WAV (lossless)",
                "OGG Opus (smallest)"
            ],
            "default": "mp3",
            "description": "MP3 plays everywhere; WAV for editing; OGG Opus is smallest."
        },
        "subtitles": {
            "title": "Subtitles",
            "type": "boolean",
            "description": "Also return SRT and VTT files with a cue per sentence (free).",
            "default": true
        },
        "maxCharactersPerItem": {
            "title": "Max characters per item",
            "type": "integer",
            "description": "Longer texts are cut (the result shows truncated: true). About 750–900 characters = 1 minute of speech.",
            "minimum": 100,
            "maximum": 1000000,
            "default": 200000
        }
    },
    "required": []
}
