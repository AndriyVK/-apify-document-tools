{
    "actorSpecification": 1,
    "fields": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
            "url": {
                "type": "string",
                "description": "Input video URL"
            },
            "fileName": {
                "type": [
                    "string",
                    "null"
                ]
            },
            "mode": {
                "type": "string"
            },
            "duration": {
                "type": "number",
                "description": "Seconds"
            },
            "width": {
                "type": "integer"
            },
            "height": {
                "type": "integer"
            },
            "fps": {
                "type": "number"
            },
            "codec": {
                "type": "string"
            },
            "formatName": {
                "type": "string"
            },
            "frameCount": {
                "type": "integer"
            },
            "frames": {
                "type": "array",
                "description": "index, time (s), timecode, key, url (download link), bytes"
            },
            "contactSheetUrl": {
                "type": "string"
            },
            "error": {
                "type": "string",
                "description": "Why the video could not be processed (not charged)"
            }
        }
    },
    "views": {
        "overview": {
            "title": "Overview",
            "transformation": {
                "fields": [
                    "url",
                    "duration",
                    "frameCount",
                    "contactSheetUrl",
                    "error"
                ]
            },
            "display": {
                "component": "table",
                "properties": {
                    "url": {
                        "label": "Video",
                        "format": "link"
                    },
                    "duration": {
                        "label": "Duration, s",
                        "format": "number"
                    },
                    "frameCount": {
                        "label": "Frames",
                        "format": "number"
                    },
                    "contactSheetUrl": {
                        "label": "Contact sheet",
                        "format": "image"
                    },
                    "error": {
                        "label": "Error"
                    }
                }
            }
        }
    }
}